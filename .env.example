# Copy to .env and fill in. .env is read by the Makefile and must never be committed.
# One KEY=value per line, unquoted, no spaces around the "=".

# --- AWS credentials -------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAEXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMIexampleKEY
# Only for temporary (STS / SSO) credentials. Delete the line for long-lived keys.
# AWS_SESSION_TOKEN=

# Region for everything. Keep us-east-1: CloudFront takes certificates and the
# Free plan's web ACL from that region only, and the frontend stack refuses others.
AWS_REGION=us-east-1

# --- Deployment ------------------------------------------------------------
# Prefixes resource names. The bucket becomes <PROJECT_NAME>-frontend-<account>-<region>.
# Lowercase letters, digits and hyphens only: S3 and ECR reject anything else.
PROJECT_NAME=meetings

# --- Backend ---------------------------------------------------------------
# Master password for the RDS database. Required by `make backend-deploy`.
# 8-63 characters. No /, @, ", or space.
DB_PASSWORD=

# Origins the API accepts, comma separated. The deployed frontend calls the API
# cross-origin, so keep * or list https://<FRONTEND_DOMAIN> here.
CORS_ORIGINS=*

# Custom hostname for the API. Leave empty to deploy without one.
# The frontend bundle calls https://<BACKEND_DOMAIN>; without it, the function URL.
# `make backend-dns` prints the two CNAMEs to add at the DNS provider.
BACKEND_DOMAIN=demo-api.dobosevych.com

# Custom hostname for the site, served by CloudFront. Leave empty to use the
# *.cloudfront.net domain.
# `make frontend-dns` prints the two CNAMEs to add at the DNS provider.
FRONTEND_DOMAIN=

# GitHub repository allowed to deploy from Actions, as owner/name.
# Used once, by `make github-oidc`, to scope the trust policy.
GITHUB_REPO=

# Note on values: they are read by `make`. Quoting is optional, and one pair of
# surrounding quotes is stripped. A value containing ( ) < > = or spaces works
# with make; quote it if you also want to `source` this file in zsh.
