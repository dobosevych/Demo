# Copy to .env and fill in. .env is read by the Makefile and must never be committed.
# One KEY=value per line, unquoted, no spaces around the "=".

# --- AWS credentials -------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAEXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMIexampleKEY
# Only for temporary (STS / SSO) credentials. Delete the line for long-lived keys.
# AWS_SESSION_TOKEN=

# CloudFront is global, but the bucket and stack live in one region.
AWS_REGION=us-east-

# --- Deployment ------------------------------------------------------------
# Prefixes resource names. The bucket becomes <PROJECT_NAME>-frontend-<account>-<region>.
# Lowercase letters, digits and hyphens only: S3 and ECR reject anything else.
PROJECT_NAME=meetings

# The API the deployed bundle talks to, baked in at build time.
# Leave it EMPTY to deploy the frontend on its own: the site loads and renders,
# and says it has no backend rather than showing a blank page.
# After `make backend-deploy`, set it to the URL that target prints.
VITE_API_URL=

# --- Backend ---------------------------------------------------------------
# Master password for the RDS database. Required by `make backend-deploy`.
# 8-63 characters. No /, @, ", or space.
DB_PASSWORD=

# Origins the API accepts, comma separated. "*" while you are testing;
# set it to your frontend's URL once that is deployed.
CORS_ORIGINS=*

# GitHub repository allowed to deploy from Actions, as owner/name.
# Used once, by `make github-oidc`, to scope the trust policy.
GITHUB_REPO=

# Domain for the API. Leave EMPTY for HTTP on the load balancer's own hostname.
# Set it to get HTTPS: `make cert` then add the DNS record it prints.
API_DOMAIN=

# Note on values: they are read by `make`, which does NOT strip quotes, so do
# not quote them. A value containing ( ) < > = or spaces still works with make,
# but cannot be `source`d in zsh - use `make env-export` instead.
